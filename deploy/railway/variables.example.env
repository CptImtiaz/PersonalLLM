# Copy these into each Railway service's Variables tab.
# (This file is a reference — Railway reads variables from its UI, not from
#  a committed .env. Do NOT put real secrets in the repo.)

# ================= Service A: Ollama (built from this repo) =================
PORT=11434
# 8B abliterated Qwen3 — uncensored, ships its own template, fits Railway CPU.
BASE_MODEL=huihui_ai/qwen3-abliterated:8b-v2

# ============ Service B: Open WebUI (ghcr.io/open-webui/open-webui:main) ====
# Replace <ollama> with the exact name of Service A in your project.
OLLAMA_BASE_URL=http://<ollama>.railway.internal:11434
# Any long random string — keeps you logged in across restarts.
WEBUI_SECRET_KEY=change-me-to-a-long-random-string
